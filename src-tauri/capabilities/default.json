{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main EnvManager window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text",
    "allow-get-environment-snapshot",
    "allow-save-environment-variable",
    "allow-delete-environment-variable",
    "allow-restore-environment-backup",
    "allow-undo-environment-mutation",
    "allow-transfer-environment-variable",
    "allow-get-environment-revision",
    "allow-launch-powershell",
    "allow-preview-environment-import",
    "allow-apply-environment-import",
    "allow-export-environment-file",
    "allow-get-favorites",
    "allow-toggle-favorite",
    "allow-analyze-path-entries",
    "allow-restart-elevated",
    "allow-get-command-shims",
    "allow-save-command-shim",
    "allow-delete-command-shim"
  ]
}
